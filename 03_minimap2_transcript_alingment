############################################################
# PIPELINE: MinimapTranscriptome + Salmon → DESeq2
############################################################

# ==========================================================
# 1. LIBRARIES
# ==========================================================

library(tximport)
library(DESeq2)
library(apeglm)
library(ggplot2)
library(pheatmap)
library(reshape2)
library(ggrepel)

rm(list = ls())
graphics.off()


# ==========================================================
# 2. DIRECTORIES
# ==========================================================

# Output directory
setwd("<path>")

# Salmon input directory
salmon_dir <- "<path>"


# ==========================================================
# 3. METADATA
# ==========================================================

metadata <- data.frame(
  Sample = c("BC09", "BC10", "BC11", "BC13", "BC15", "BC16"),
  Condition = c("WT", "WT", "WT", "Mdx", "Mdx", "Mdx"),
  label = c("WT5", "WT6", "WT14", "Mdx2", "Mdx15", "Mdx90")
)

rownames(metadata) <- metadata$Sample

# Set reference level: Mdx vs WT
metadata$Condition <- factor(
  metadata$Condition,
  levels = c("Mdx", "WT")
)


# ==========================================================
# 4. SALMON INPUT FILES (.sf)
# ==========================================================

files <- list.files(
  salmon_dir,
  pattern = "quant_.*\\.sf$",
  full.names = TRUE
)

names(files) <- gsub(
  "quant_|\\.sf",
  "",
  basename(files)
)


# ==========================================================
# 5. TXIMPORT — TRANSCRIPT LEVEL
# ==========================================================

txi <- tximport(
  files,
  type = "salmon",
  txOut = TRUE
)


# ==========================================================
# 6. DESEQ2 DATASET
# ==========================================================

dds <- DESeqDataSetFromTximport(
  txi,
  colData = metadata,
  design = ~ Condition
)


# ==========================================================
# 7. FILTERING
# ==========================================================

dds <- dds[
  rowSums(counts(dds)) >= 10,
]


# ==========================================================
# 8. DIFFERENTIAL EXPRESSION ANALYSIS
# ==========================================================

dds <- DESeq(dds)

res <- results(dds)

res <- lfcShrink(
  dds,
  coef = 2,
  type = "apeglm"
)


# ==========================================================
# 9. RESULTS DATAFRAME
# ==========================================================

res_df <- as.data.frame(res)

res_df$Gene <- rownames(res_df)

# Remove ":" from gene/transcript identifiers
res_df$Gene <- gsub(":", "", res_df$Gene)


# ==========================================================
# 10. DIFFERENTIAL EXPRESSION CATEGORIES
# ==========================================================

res_df$DEG_flag <- (
  !is.na(res_df$padj) &
  res_df$padj < 0.05 &
  abs(res_df$log2FoldChange) > 1
)

res_df$Up_in <- ifelse(
  res_df$log2FoldChange > 0,
  "WT",
  "Mdx"
)


# ==========================================================
# 11. EXPORT ALL GENES
# ==========================================================

write.csv2(
  res_df,
  "All_genes_SalmonTranscriptome_DESeq2.csv",
  row.names = FALSE
)


# ==========================================================
# 12. TRANSFORMATION FOR PCA AND HEATMAP
# ==========================================================

vsd <- vst(
  dds,
  blind = FALSE
)

expr <- assay(vsd)

# Remove ":" from identifiers
rownames(expr) <- gsub(
  ":",
  "",
  rownames(expr)
)


# ==========================================================
# 13. VIOLIN PLOT
# ==========================================================

df <- melt(expr)

colnames(df) <- c(
  "Gene",
  "Sample",
  "Expression"
)

df$Label <- metadata[
  df$Sample,
  "label"
]

df$Condition <- metadata[
  df$Sample,
  "Condition"
]

orden <- c(
  "WT5",
  "WT6",
  "WT14",
  "Mdx2",
  "Mdx15",
  "Mdx90"
)

df$Label <- factor(
  df$Label,
  levels = orden
)

ggplot(
  df,
  aes(
    Label,
    Expression,
    fill = Condition
  )
) +
  geom_violin(
    alpha = 0.7,
    trim = TRUE,
    color = "black"
  ) +
  scale_fill_manual(
    values = c(
      "WT" = "skyblue",
      "Mdx" = "maroon4"
    )
  ) +
  coord_cartesian(
    ylim = c(
      quantile(df$Expression, 0.01),
      quantile(df$Expression, 0.99)
    )
  ) +
  theme_bw() +
  labs(
    title = "Distribution of expression by sample",
    x = "Sample",
    y = "Expression"
  ) +
  theme(
    axis.text.x = element_text(
      angle = 45,
      hjust = 1
    ),
    plot.title = element_text(
      hjust = 0.5
    )
  )


# ==========================================================
# 14. PCA
# ==========================================================

pca <- prcomp(
  t(expr)
)

percentVar <- round(
  100 * (pca$sdev^2 / sum(pca$sdev^2)),
  1
)

pca_df <- data.frame(
  pca$x,
  metadata
)

ggplot(
  pca_df,
  aes(
    PC1,
    PC2,
    color = Condition
  )
) +
  geom_point(size = 5) +
  geom_text_repel(
    aes(label = label),
    size = 4
  ) +
  scale_color_manual(
    values = c(
      "WT" = "skyblue",
      "Mdx" = "maroon4"
    )
  ) +
  theme_bw() +
  labs(
    x = paste0(
      "PC1 (",
      percentVar[1],
      "%)"
    ),
    y = paste0(
      "PC2 (",
      percentVar[2],
      "%)"
    ),
    title = "PCA"
  )


# ==========================================================
# 15. VOLCANO PLOT
# ==========================================================

res_df$Significant <- ifelse(
  res_df$DEG_flag,
  "YES",
  "NO"
)

ggplot(
  res_df,
  aes(
    log2FoldChange,
    -log10(padj),
    color = Significant
  )
) +
  geom_point(
    alpha = 0.7,
    size = 1.5
  ) +
  geom_hline(
    yintercept = -log10(0.05),
    linetype = "dashed",
    color = "black"
  ) +
  geom_vline(
    xintercept = c(-1, 1),
    linetype = "dashed",
    color = "black"
  ) +
  scale_color_manual(
    values = c(
      "NO" = "grey70",
      "YES" = "#D55E00"
    )
  ) +
  theme_bw() +
  labs(
    title = "Volcano plot",
    x = "log2 Fold Change",
    y = "-log10(padj)",
    color = "Significant"
  )


# ==========================================================
# 16. HEATMAP — DIFFERENTIALLY EXPRESSED GENES
# ==========================================================

sig <- res_df$Gene[
  res_df$DEG_flag == TRUE
]

# Keep only significant genes present in the expression matrix
sig <- intersect(
  sig,
  rownames(expr)
)

mat <- expr[sig, ]

# Replace sample IDs with descriptive labels
colnames(mat) <- metadata[
  colnames(mat),
  "label"
]

# Reorder samples
mat <- mat[, orden]

pheatmap(
  mat,
  scale = "row",
  fontsize_row = 2,
  fontsize_col = 10,
  cluster_cols = TRUE,
  show_rownames = FALSE
)


# ==========================================================
# 17. EXPORT NORMALIZED EXPRESSION MATRIX
# ==========================================================

norm_counts <- counts(
  dds,
  normalized = TRUE
)

expr_df <- as.data.frame(
  norm_counts
)

expr_df$Gene <- rownames(
  expr_df
)

expr_df <- expr_df[
  ,
  c(
    "Gene",
    colnames(norm_counts)
  )
]

write.csv2(
  expr_df,
  "Expression_matrix_normalized_counts.csv",
  row.names = FALSE
)
